<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://java.sun.com/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://java.sun.com/xml/ns/javaee http://java.sun.com/xml/ns/javaee/web-app_2_5.xsd"
         version="2.5">
  <display-name>AI-Powered Session Recommender</display-name>
  
  <!-- Recommendation Servlet -->
  <servlet>
    <servlet-name>RecommendationServlet</servlet-name>
    <servlet-class>com.example.servlet.RecommendationServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>RecommendationServlet</servlet-name>
    <url-pattern>/api/recommendations</url-pattern>
  </servlet-mapping>
  
  <!-- User Profile Servlet -->
  <servlet>
    <servlet-name>UserProfileServlet</servlet-name>
    <servlet-class>com.example.servlet.UserProfileServlet</servlet-class>
  </servlet>
  <servlet-mapping>
    <servlet-name>UserProfileServlet</servlet-name>
    <url-pattern>/api/user</url-pattern>
  </servlet-mapping>
  
  <!-- Enable CORS for API endpoints -->
  <filter>
    <filter-name>CorsFilter</filter-name>
    <filter-class>com.example.filter.CorsFilter</filter-class>
  </filter>
  <filter-mapping>
    <filter-name>CorsFilter</filter-name>
    <url-pattern>/api/*</url-pattern>
  </filter-mapping>
</web-app>
